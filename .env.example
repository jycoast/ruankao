# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）。

# MySQL root 密码，同时作为后端连库密码
MYSQL_ROOT_PASSWORD=

# 数据库 / Redis 地址。默认取镜像内的 config/config.yaml（容器网络里是服务名 mysql / redis），
# 留空即回落，不会把地址清空。只有要连容器外的库时才需要填。
# 注意 localhost 在容器内指向容器自身；连宿主机上的库要用宿主机地址
# （Docker Desktop 用 host.docker.internal，Linux 用 172.17.0.1 或宿主机局域网 IP）。
SOFTWARE_EXAM_DATABASE_HOST=
SOFTWARE_EXAM_DATABASE_PORT=
SOFTWARE_EXAM_DATABASE_USER=
SOFTWARE_EXAM_REDIS_HOST=
SOFTWARE_EXAM_REDIS_PORT=

# 站点对外地址，含协议、末尾不带 /，如 https://ruankao.example.com
# sitemap 与 canonical 需要绝对 URL；留空则不对外提供 sitemap
SOFTWARE_EXAM_SERVER_SITE_URL=

# JWT 签名密钥，≥32 字符。生成：openssl rand -base64 48
# 泄露 = 任何人可自签 role:1 的 token 成为管理员
SOFTWARE_EXAM_JWT_SECRET=

# LinuxDo OAuth（不用可留空）
SOFTWARE_EXAM_OAUTH_LINUXDO_CLIENT_ID=
SOFTWARE_EXAM_OAUTH_LINUXDO_CLIENT_SECRET=

# 易支付商户信息（不用可留空）
SOFTWARE_EXAM_YIPAY_PID=
SOFTWARE_EXAM_YIPAY_KEY=

# LINUX DO Credit 积分支付（不用可留空）
SOFTWARE_EXAM_LDC_PID=
SOFTWARE_EXAM_LDC_KEY=

# 悦通云支付（不用可留空）。签名用非对称密钥，两把不同的钥匙：
# 商户私钥给下单签名，平台公钥给回调验签。均为裸 base64，不含 PEM 头尾。
SOFTWARE_EXAM_YUETONGYUN_PID=
SOFTWARE_EXAM_YUETONGYUN_MERCHANT_PRIVATE_KEY=
SOFTWARE_EXAM_YUETONGYUN_PLATFORM_PUBLIC_KEY=

# 腾讯云 COS（后台编辑器粘贴上传图片用，不用可留空）
SOFTWARE_EXAM_OSS_ACCESS_KEY=
SOFTWARE_EXAM_OSS_SECRET_KEY=
